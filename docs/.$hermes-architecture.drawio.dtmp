        <mxCell id="p3_s1" value="稳定依赖 · I=0.06" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_agent" target="p3_const">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_tools" target="p3_const">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ===== 图例 ===== -->
        <mxCell id="p3_L" value="图例 · 耦合强度" style="swimlane;startSize=30;html=1;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="990" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3_L1" value="循环耦合（双向环）· 线宽 ∝ 引用总数" style="text;html=1;fontFamily=PingFang SC;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="p3_L">
          <mxGeometry x="130" y="40" width="380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3_L1s" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#b85450;strokeWidth=6;" edge="1" parent="p3_L">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" y="50" as="sourcePoint" />
            <mxPoint x="120" y="50" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_L2" value="单向强耦合（≥100 处引用）" style="text;html=1;fontFamily=PingFang SC;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="p3_L">
          <mxGeometry x="130" y="80" width="380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3_L2s" value="" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=3.5;" edge="1" parent="p3_L">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" y="90" as="sourcePoint" />
            <mxPoint x="120" y="90" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_L3" value="稳定依赖（指向低 I 的基石模块，健康）" style="text;html=1;fontFamily=PingFang SC;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="p3_L">
          <mxGeometry x="130" y="120" width="380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3_L3s" value="" style="endArrow=classic;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="p3_L">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" y="130" as="sourcePoint" />
            <mxPoint x="120" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_L4" value="边标注格式：⇄ 总数　模 = 模块顶层 import ／ 延 = 函数体内延迟 import" style="text;html=1;fontFamily=PingFang SC;fontSize=10;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="p3_L">
          <mxGeometry x="15" y="148" width="495" height="20" as="geometry" />
        </mxCell>
        <!-- ===== 结论 ===== -->
        <mxCell id="p3_note" value="读图要点" style="swimlane;startSize=30;html=1;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="990" width="620" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3_n1" value="① hermes_cli 是耦合黑洞：全仓 8 个循环耦合环里它占 5 个，流量 2,795 居首，Ca 16 / Ce 19 双高——既被广泛依赖又广泛依赖别人，是最难安全改动的模块。&#xa;&#xa;② 环几乎全由延迟 import 撑起：hermes_cli ⇄ agent 的 784 处引用中，模块顶层只占 58 处，其余 726 处在函数体内。这是 facade + siblings 约定刻意为之——代价是打桩要打在门面上，不能打在定义处。&#xa;&#xa;③ 健康的部分：hermes_constants（I=0.06）被 15 个模块依赖却几乎不依赖别人，是合格的稳定基石；plugins（I=0.69）、tui_gateway（I=0.79）虽高不稳定但 Ca 低，属正常的边缘模块。&#xa;&#xa;④ 值得警惕：gateway 的 Ce 16 高于 Ca 10（I=0.62）——它被当作核心服务，实际却在向外索取依赖；cron、tui_gateway、web_server、acp 都直接 import 它的子模块，而不是通过某个稳定接口。" style="text;html=1;fontFamily=PingFang SC;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;" vertex="1" parent="p3_note">
          <mxGeometry x="10" y="34" width="600" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
