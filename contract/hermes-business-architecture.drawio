        <mxCell id="s491" value="&lt;b&gt;⑧ 学习沉淀&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot; style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;agent/background_review.py&lt;/font&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="3115" y="3314" width="455" height="66" as="geometry" /></mxCell>
        <mxCell id="loop" value="④ ⇄ ⑤ 循环：模型返回 tool_calls 时经 agent/turn_tool_round.py 执行工具并回灌结果，直到最终回复或触达 agent/iteration_budget.py / turn_stop_gates.py；Goals 持久目标（hermes_cli/goals.py）在轮次结束后由辅助模型判定是否继续。" style="text;html=1;fontSize=12;fontFamily=PingFang SC;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3386" width="3530" height="24" as="geometry" /></mxCell>
        <mxCell id="GUIDE" value="AgentRuntime 抽取指南（依赖统计：对闭包内 608 个 .py 文件的 import 语句逐行扫描 · 基线 fc71fb63e5）" style="swimlane;startSize=38;html=1;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fillColor=#f8cecc;strokeColor=#c0392b;swimlaneFillColor=#fffafa;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="3434" width="3530" height="330" as="geometry" /></mxCell>
        <mxCell id="gt492" value="① 最小依赖闭包（整体带走）" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#8e2b21;align=left;verticalAlign=middle;" vertex="1" parent="GUIDE"><mxGeometry x="20" y="48" width="1150" height="26" as="geometry" /></mxCell>
        <mxCell id="gb493" value="&lt;b&gt;入口&lt;/b&gt;：&lt;font face='Menlo'&gt;run_agent.py&lt;/font&gt;（AIAgent · run_conversation）&lt;br&gt;&lt;b&gt;内核&lt;/b&gt;：&lt;font face='Menlo'&gt;agent/&lt;/font&gt;（turn_* 轮次 · 提示 · 模型接入 · 学习 · 委派 · 注册表）&lt;br&gt;&lt;b&gt;工具&lt;/b&gt;：&lt;font face='Menlo'&gt;model_tools.py · toolsets.py · toolset_distributions.py · tools/&lt;/font&gt;&lt;br&gt;&lt;b&gt;状态&lt;/b&gt;：&lt;font face='Menlo'&gt;hermes_state.py + hermes_state_*.py&lt;/font&gt;（21 个兄弟模块）&lt;br&gt;&lt;b&gt;基础&lt;/b&gt;：&lt;font face='Menlo'&gt;hermes_constants.py · hermes_logging.py · hermes_time.py · utils.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;内部依赖链：&lt;font face='Menlo'&gt;tools/registry.py&lt;/font&gt;（零本地依赖）← &lt;font face='Menlo'&gt;tools/*.py&lt;/font&gt; 导入时自注册 ← &lt;font face='Menlo'&gt;model_tools.py&lt;/font&gt; 发现 ← &lt;font face='Menlo'&gt;run_agent.py&lt;/font&gt;" style="text;html=1;fontFamily=PingFang SC;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=4;" vertex="1" parent="GUIDE"><mxGeometry x="20" y="76" width="1150" height="240" as="geometry" /></mxCell>
        <mxCell id="gt494" value="② 闭包向外的反向依赖（必须切断或注入）" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#8e2b21;align=left;verticalAlign=middle;" vertex="1" parent="GUIDE"><mxGeometry x="1190" y="48" width="1150" height="26" as="geometry" /></mxCell>
        <mxCell id="gb495" value="&lt;b&gt;hermes_cli · 654 处&lt;/b&gt;（顶层 64 / 函数内延迟 590，分布在 240 个文件）&lt;br&gt;　config 194 · auth 58 · plugin_compat 56 · plugins 38 · _subprocess_compat 30&lt;br&gt;&lt;b&gt;gateway · 105 处&lt;/b&gt;（顶层仅 2）&lt;br&gt;　session_context 41 · status 16 · platforms 16 · config 11 · platform_registry 8&lt;br&gt;&lt;b&gt;cron · 25 处&lt;/b&gt;：jobs 9 · scheduler 9 · lifecycle_guard 3&lt;br&gt;&lt;b&gt;plugins · 20 处&lt;/b&gt;：platforms 7 · web 5 · memory 3 · browser 2&lt;br&gt;&lt;b&gt;tui_gateway 2 · acp_adapter 1 · cli 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#8e2b21'&gt;绝大多数是函数体内的延迟 import —— 导入期不会失败，运行到对应分支才报错，抽取后必须按调用路径做 E2E 验证。&lt;/font&gt;" style="text;html=1;fontFamily=PingFang SC;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=4;" vertex="1" parent="GUIDE"><mxGeometry x="1190" y="76" width="1150" height="240" as="geometry" /></mxCell>
        <mxCell id="gt496" value="③ 建议的接缝（按引用量排序）" style="text;html=1;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#8e2b21;align=left;verticalAlign=middle;" vertex="1" parent="GUIDE"><mxGeometry x="2360" y="48" width="1150" height="26" as="geometry" /></mxCell>
        <mxCell id="gb497" value="&lt;b&gt;1. 配置读取&lt;/b&gt;：hermes_cli.config（194）→ 抽出 ConfigSource 接口注入&lt;br&gt;&lt;b&gt;2. 凭证解析&lt;/b&gt;：hermes_cli.auth（58）→ CredentialProvider 接口&lt;br&gt;&lt;b&gt;3. 兼容指针&lt;/b&gt;：hermes_cli.plugin_compat（56）→ AGENTS.md 标注 2026-09-14 随兼容层移除，改为从定义模块导入&lt;br&gt;&lt;b&gt;4. 会话上下文&lt;/b&gt;：gateway.session_context（41）→ SessionContext 由宿主注入&lt;br&gt;&lt;b&gt;5. 插件发现&lt;/b&gt;：hermes_cli.plugins（38）+ plugins.*（20）→ PluginRegistry 接口&lt;br&gt;&lt;b&gt;6. 宿主回调&lt;/b&gt;：gateway.status / cron.* → 事件回调，由宿主实现&lt;br&gt;&lt;br&gt;&lt;font color='#8e2b21'&gt;注意 contract/README.md 规则 4：只依赖 HTTP/WS 契约、不 import 上游内部路径；代码级抽取对应 b-line 决策文档中已弃用的「方案 2」，会失去自动跟随上游的能力。&lt;/font&gt;" style="text;html=1;fontFamily=PingFang SC;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;spacingTop=4;" vertex="1" parent="GUIDE"><mxGeometry x="2360" y="76" width="1150" height="240" as="geometry" /></mxCell>
        <mxCell id="legT" value="图例" style="text;html=1;fontSize=14;fontStyle=1;fontFamily=PingFang SC;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3784" width="60" height="26" as="geometry" /></mxCell>
